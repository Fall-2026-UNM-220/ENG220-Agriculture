    "United States!!Households!!Estimate",
    "United States!!Households!!Margin of Error"
]

display(median_row[columns_to_check].T)

# Visualization

# Find median household income row
median_row = df[
    df["Label (Grouping)"].str.strip() == "Median income (dollars)"
].iloc[0]

# Geographic areas
locations = ["Cuba CCD", "New Mexico", "United States"]

# Income estimates
income = [31899, 64059, 80734]

# Margins of error
margin_error = [4981, 808, 166]

# Create bar graph with error bars
plt.figure(figsize=(10, 6))

bars = plt.bar(
    locations,
    income,
    yerr=margin_error,
    capsize=7
)

# Add dollar amounts above bars
for bar, value, error in zip(bars, income, margin_error):
    plt.text(
        bar.get_x() + bar.get_width() / 2,
        value + error + 1500,
        f"${value:,.0f}",
        ha="center",
        fontsize=11
    )

# Graph formatting
plt.title("Median Household Income Comparison", fontsize=15)
plt.xlabel("Geographic Area")
plt.ylabel("Median Household Income ($)")
plt.ylim(0, 100000)
plt.grid(axis="y", linestyle="--", alpha=0.4)

plt.tight_layout()

# Save graph
plt.savefig("Graph1_Median_Household_Income.png", dpi=300)

plt.show()
