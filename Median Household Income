]

# Display the geographic estimates and margins of error
columns_to_check = [
    "Label (Grouping)",
    "Cuba CCD, Sandoval County, New Mexico!!Households!!Estimate",
    "Cuba CCD, Sandoval County, New Mexico!!Households!!Margin of Error",
    "New Mexico!!Households!!Estimate",
